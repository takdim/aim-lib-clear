# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=ganti-dengan-secret-key-yang-sangat-panjang-dan-acak

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bebas_pustaka_db
DB_USER=root
DB_PASSWORD=password_mysql_kamu

# Upload
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880

# File Retention (hari)
FILE_RETENTION_DAYS=30

# Nomor Surat
NOMOR_SURAT_PREFIX=PERPUS
NAMA_INSTITUSI=Universitas Contoh
NAMA_PERPUSTAKAAN=UPT Perpustakaan Universitas Contoh
